{
  "name": "Sophos Core - Sincronizar Calificaciones Sheets",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sync-sheets",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1e7f6e0b-22a4-4f0f-8ec3-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "sync-sheets"
    },
    {
      "parameters": {
        "jsCode": "// Datos recibidos del webhook de Sophos Core\nconst body = $input.item.json.body || $input.item.json;\nconst periodoNum = body.periodo_num || 1;\nconst spreadsheetId = body.spreadsheet_id || 'ID_DE_TU_GOOGLE_SHEET';\n\nreturn {\n  periodo_num: periodoNum,\n  spreadsheet_id: spreadsheetId,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "1e7f6e0b-22a4-4f0f-8ec3-000000000002",
      "name": "Procesar Petición",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Simulación / Transformación de notas para Supabase\n// En producción este nodo procesa las filas leídas del Google Sheet\nconst input = $input.item.json;\n\nreturn {\n  status: 'success',\n  periodo_procesado: input.periodo_num,\n  resumen: {\n    total_alumnos_procesados: 1,\n    total_calificaciones_guardadas: 1,\n    cursos_actualizados_en_este_cargue: ['Ejemplo Curso'],\n    total_cursos_pendientes: 0\n  },\n  cursos_pendientes: [],\n  advertencias: [],\n  errores: []\n};"
      },
      "id": "1e7f6e0b-22a4-4f0f-8ec3-000000000003",
      "name": "Formatear Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "1e7f6e0b-22a4-4f0f-8ec3-000000000004",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        940,
        300
      ]
    }
  ],
